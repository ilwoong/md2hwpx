# 웹 서비스의 GitLab·Gitea 로그인(OAuth2) 설정. .env 로 복사해 값을 채운다 (.env 는 커밋하지 않는다).
# 서버마다 URL, CLIENT_ID, CLIENT_SECRET 을 모두 채워야 그 서버의 로그인이 켜진다. 쓰지 않는 서버는 비워 둔다.

# 웹 서비스 주소: 사용자의 브라우저가 접속하는 주소 (뒤의 / 없이)
MD2HWPX_BASE_URL=http://md2hwpx.internal:8000

# GitLab: 사용자 설정 > Applications (또는 관리자 영역 > Applications) 에서 애플리케이션을 만든다.
#   Redirect URI: <MD2HWPX_BASE_URL>/oauth/gitlab/callback, Confidential: 켬, Scopes: read_repository
MD2HWPX_GITLAB_URL=
MD2HWPX_GITLAB_CLIENT_ID=
MD2HWPX_GITLAB_CLIENT_SECRET=

# Gitea: 사용자 설정 > 애플리케이션 > OAuth2 애플리케이션 관리 에서 애플리케이션을 만든다.
#   Redirect URI: <MD2HWPX_BASE_URL>/oauth/gitea/callback, Confidential client: 켬
MD2HWPX_GITEA_URL=
MD2HWPX_GITEA_CLIENT_ID=
MD2HWPX_GITEA_CLIENT_SECRET=
