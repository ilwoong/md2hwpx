# 웹 서비스 설정. .env 로 복사해 값을 채운다 (.env 는 커밋하지 않는다). 바꾼 뒤에는 docker compose up -d 로 다시 실행한다.

# 요청 하나가 올릴 수 있는 크기 (MB): 올린 파일과 zip 을 푼 파일, 템플릿의 합계. 비우면 50.
# 올린 파일은 메모리(/tmp, tmpfs)에 두므로, 동시에 변환하는 요청마다 이 크기의 두세 배까지 메모리를 쓴다.
# /tmp 는 모두 합쳐 1GB 까지다 (compose.yaml 의 tmpfs size): 이 값을 크게 올리면 그것도 같이 올린다.
MD2HWPX_MAX_UPLOAD_MB=

# GitLab·Gitea 로그인(OAuth2) 설정.
# 서버마다 URL, CLIENT_ID, CLIENT_SECRET 을 모두 채워야 그 서버의 로그인이 켜진다. 쓰지 않는 서버는 비워 둔다.
# 설정 절차와 문제 해결: README.md 의 "GitLab·Gitea 로그인 설정".

# 웹 서비스 주소: 사용자의 브라우저가 접속하는 주소 그대로 (뒤의 / 없이, localhost 와 127.0.0.1 도 다른 주소)
MD2HWPX_BASE_URL=http://md2hwpx.internal:8000

# GitLab·Gitea 주소(*_URL): 브라우저와 md2hwpx 컨테이너 양쪽에서 접속되는 주소 (컨테이너 안의 localhost 는 쓸 수 없다)

# GitLab: 사용자 설정 > Applications (또는 관리자 영역 > Applications) 에서 애플리케이션을 만든다.
#   Redirect URI: <MD2HWPX_BASE_URL>/oauth/gitlab/callback, Confidential: 켬, Scopes: read_repository
MD2HWPX_GITLAB_URL=
MD2HWPX_GITLAB_CLIENT_ID=
MD2HWPX_GITLAB_CLIENT_SECRET=

# Gitea: 사용자 설정 > 애플리케이션 > OAuth2 애플리케이션 관리 에서 애플리케이션을 만든다.
#   Redirect URI: <MD2HWPX_BASE_URL>/oauth/gitea/callback, Confidential client: 켬
MD2HWPX_GITEA_URL=
MD2HWPX_GITEA_CLIENT_ID=
MD2HWPX_GITEA_CLIENT_SECRET=
